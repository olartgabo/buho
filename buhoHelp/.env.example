# UPB credentials, used for both UPB Virtual (Moodle) and UPBnet.
# Usually set once in buho/.env instead.
ID=
PASSWORD=

# Optional: a Moodle web-services token; takes precedence over ID/PASSWORD for Moodle.
MOODLE_TOKEN=

# Shared by both platforms' tools.
DOWNLOAD_DIR=./downloads
VAULT_DIR=./vault
CACHE_DIR=./.cache

# HTTP transport only: require Authorization: Bearer <token>.
MCP_HTTP_TOKEN=
