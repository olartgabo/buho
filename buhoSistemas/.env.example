# UPBnet credentials: your numeric código de acceso and password.
# Usually set once in buho/.env and shared with buhoVirtual.
ID=
PASSWORD=

# UPBnet site root (no trailing slash).
UPBNET_BASE_URL=https://sistemas.upb.edu

# Where downloaded exam PDFs are saved (under exams/<subject>/).
DOWNLOAD_DIR=./downloads

# Where converted exams are written (under <subject>/exams/).
VAULT_DIR=./vault

# Where the incremental-sync metadata cache is kept.
CACHE_DIR=./.cache
