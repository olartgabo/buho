# Base URL of your Moodle site (no trailing slash), including the subpath.
MOODLE_BASE_URL=https://www.upbvirtual.net/upbvirtual

# UPB credentials. If MOODLE_TOKEN is empty, the server exchanges these for a
# token at startup. Usually set once in buho/.env and shared with buhoSistemas.
ID=
PASSWORD=

# Optional: a web-services token (npm run get-token). Takes precedence over ID/PASSWORD.
MOODLE_TOKEN=

# Where downloaded attachments/materials are saved.
DOWNLOAD_DIR=./downloads

# Where synced course material (markdown + files) is written.
VAULT_DIR=./vault

# Where the incremental-sync metadata cache is kept.
CACHE_DIR=./.cache
