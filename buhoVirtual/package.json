{
  "name": "@buho/virtual",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for UPB Virtual (Moodle) — query courses, assignments, deadlines and materials via the Moodle Web Services REST API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http-app.d.ts",
      "default": "./dist/http-app.js"
    },
    "./pdf": {
      "types": "./dist/vault/pdf.d.ts",
      "default": "./dist/vault/pdf.js"
    }
  },
  "bin": {
    "buho-virtual": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "get-token": "tsx scripts/get-token.ts",
    "inspect": "npx @mcpjam/inspector@latest"
  },
  "keywords": [
    "mcp",
    "moodle",
    "upb",
    "lms",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "pdf-parse": "^1.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
