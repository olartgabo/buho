{
  "name": "buho",
  "private": true,
  "type": "module",
  "workspaces": [
    "buhoVirtual",
    "buhoSistemas",
    "buhoHelp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
